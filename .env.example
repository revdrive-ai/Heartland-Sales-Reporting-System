# Copy to .env.local for local development. Never commit .env.local (gitignored).
# Which Supabase project the app talks to is decided HERE and nowhere in code.
# Values come from Supabase → Project Settings → API.

# The project URL — used for sign-in AND data, so both always hit one project.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# The public (anon / publishable) key. Safe in the browser: RLS lets it read nothing.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role secret. Server-side only (route handlers, loaders); bypasses RLS.
# Without it the app keeps shared plan state in data/store/ on disk instead.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the host's scheduler sends to /api/cron/le-lock (Authorization: Bearer …).
CRON_SECRET=

# Optional: where the file backend of /api/state keeps its documents when
# Supabase isn't configured (default: data/store/ in the project).
# APP_STATE_DIR=
